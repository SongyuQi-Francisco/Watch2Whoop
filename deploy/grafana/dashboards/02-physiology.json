     "rawSql": "WITH s AS (SELECT date, v FROM (SELECT date, hrv_night_ln AS v FROM daily_scores WHERE user_id = $user) x WHERE v IS NOT NULL AND date BETWEEN ($__timeFrom()::timestamptz)::date - 61 AND ($__timeTo()::timestamptz)::date), b AS (SELECT date, v, avg(v) OVER w AS m, stddev_samp(v) OVER w AS sd, count(v) OVER w AS n FROM s WINDOW w AS (ORDER BY date RANGE BETWEEN '60 days'::interval PRECEDING AND '1 day'::interval PRECEDING)) SELECT date::timestamptz AS time, v AS \"ln HRV\", CASE WHEN n >= 14 THEN m - sd END AS \"基线下沿\", CASE WHEN n >= 14 THEN m END AS \"60 天基线\", CASE WHEN n >= 14 THEN m + sd END AS \"基线上沿\" FROM b WHERE date >= ($__timeFrom()::timestamptz)::date ORDER BY 1"

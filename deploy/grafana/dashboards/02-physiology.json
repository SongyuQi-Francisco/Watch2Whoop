  {
   "type": "timeseries",
   "title": "HRV（ln SDNN）",
   "description": "睡眠窗口内 SDNN 读数取 ln 后的中位数（Apple 夜里只测 1–3 次，单条读数的晚上很吵）。低于灰带下沿 = 恢复差。ln 4.0 ≈ 55 ms，3.5 ≈ 33 ms。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",

 "panels": [
  {
   "type": "timeseries",
   "title": "静息心率（睡眠期最低 5 分钟）",
   "description": "恢复分用的当晚值；没有睡眠期心率的天退回 Apple 全天 resting_heart_rate。灰带 = 前 60 天均值 ± 1 SD（≥ 14 晚才画）。高于灰带上沿 = 偏高（疲劳 / 生病 / 喝酒 / 晚睡）。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "WITH s AS (SELECT date, v FROM (SELECT date, rhr_night AS v FROM daily_scores WHERE user_id = $user) x WHERE v IS NOT NULL AND date BETWEEN ($__timeFrom()::timestamptz)::date - 61 AND ($__timeTo()::timestamptz)::date), b AS (SELECT date, v, avg(v) OVER w AS m, stddev_samp(v) OVER w AS sd, count(v) OVER w AS n FROM s WINDOW w AS (ORDER BY date RANGE BETWEEN '60 days'::interval PRECEDING AND '1 day'::interval PRECEDING)) SELECT date::timestamptz AS time, v AS \"静息心率\", CASE WHEN n >= 14 THEN m - sd END AS \"基线下沿\", CASE WHEN n >= 14 THEN m END AS \"60 天基线\", CASE WHEN n >= 14 THEN m + sd END AS \"基线上沿\" FROM b WHERE date >= ($__timeFrom()::timestamptz)::date ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "body-engine"
   },

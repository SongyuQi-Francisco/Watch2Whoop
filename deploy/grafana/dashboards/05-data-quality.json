     "rawSql": "SELECT CASE WHEN ds.source = 'apple_health_xml' THEN 'export.xml' WHEN ds.device_type = 'watch' THEN 'OW app · 手表' WHEN ds.device_type = 'phone' THEN 'OW app · 手机' ELSE 'OW app · 其他' END AS \"来源\", max(p.created_at) AS \"最后写入\", max(p.created_at) AS \"多久前\", max(p.recorded_at) AS \"最新样本时间\" FROM data_point_series p JOIN data_source ds ON ds.id = p.data_source_id WHERE ds.user_id = '$ow_user' AND p.recorded_at > now() - interval '30 days' GROUP BY 1 ORDER BY 2 DESC"

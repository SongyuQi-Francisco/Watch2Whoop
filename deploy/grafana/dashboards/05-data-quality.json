        "value": null
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "时间"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsLocalNoDateIfToday"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "多久前"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeFromNow"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       }
      ]
     }
    ]
   },

        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 0,
     "min": 0,
     "max": 24
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "不够（< 12 小时）"
      },
      "properties": [
       {
        "id": "color",

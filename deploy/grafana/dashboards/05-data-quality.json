  {
   "type": "timeseries",
   "title": "OW 原始样本数（按来源）",
   "description": "Open Wearables 库里每天的原始样本（心率、HRV、步数……）条数。export.xml 是 2026-10-14 导入的全量历史，之后靠 iPhone 上的 OW app 同步。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "open-wearables"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT (p.recorded_at AT TIME ZONE 'Australia/Sydney')::date::timestamptz AS time, CASE WHEN ds.source = 'apple_health_xml' THEN 'export.xml' WHEN ds.device_type = 'watch' THEN 'OW app · 手表' WHEN ds.device_type = 'phone' THEN 'OW app · 手机' ELSE 'OW app · 其他' END AS metric, count(*) AS value FROM data_point_series p JOIN data_source ds ON ds.id = p.data_source_id WHERE ds.user_id = '$ow_user' AND p.recorded_at >= $__timeFrom()::timestamptz - interval '1 day' AND p.recorded_at < $__timeTo()::timestamptz GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "open-wearables"
   },
   "fieldConfig": {

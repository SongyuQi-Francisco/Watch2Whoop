  {
   "type": "timeseries",
   "title": "有心率的小时数",
   "description": "strain 要一天里 ≥ 12 个小时有心率（否则 no_raw_hr / hr_coverage_low）。红 = 不够。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "open-wearables"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "WITH h AS ( SELECT (p.recorded_at AT TIME ZONE 'Australia/Sydney')::date AS d, count(DISTINCT date_trunc('hour', p.recorded_at)) AS n FROM data_point_series p JOIN data_source ds ON ds.id = p.data_source_id JOIN series_type_definition t ON t.id = p.series_type_definition_id WHERE ds.user_id = '$ow_user' AND t.code = 'heart_rate' AND p.recorded_at >= $__timeFrom()::timestamptz - interval '1 day' AND p.recorded_at < $__timeTo()::timestamptz GROUP BY 1) SELECT d::timestamptz AS time, CASE WHEN n < 12 THEN n END AS \"不够（< 12 小时）\", CASE WHEN n >= 12 THEN n END AS \"够（≥ 12 小时）\" FROM h ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "open-wearables"
   },
   "fieldConfig": {
    "defaults": {

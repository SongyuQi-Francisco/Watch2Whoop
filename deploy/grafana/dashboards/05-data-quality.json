  {
   "type": "table",
   "transformations": [],
   "title": "Body Engine：最近同步 / 计算",
   "description": "每小时 :10 的定时任务会更新这几行。超过 2 小时没动 → 看 deploy/ops/doctor.sh。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT * FROM ( SELECT CASE source WHEN 'ow' THEN '从 OW 导入（import-ow）' WHEN 'shortcut' THEN '快捷指令导入' WHEN 'apple_export' THEN '全量导出导入' ELSE source END AS \"任务\", last_synced_at AS \"时间\", last_synced_at AS \"多久前\", cursor AS \"游标 / 数据到\" FROM sync_state WHERE user_id = $user UNION ALL SELECT '评分计算（compute-scores）', max(computed_at), max(computed_at), max(date)::text FROM daily_scores WHERE user_id = $user UNION ALL SELECT '规则评估（evaluate-rules）', max(ran_at), max(ran_at), max(date)::text FROM rule_runs WHERE user_id = $user ) x ORDER BY \"时间\" DESC"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "body-engine"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },

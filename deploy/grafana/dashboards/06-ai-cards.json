  {
   "type": "table",
   "transformations": [],
   "title": "定期发放规则",
   "description": "`body-engine ai-cards rule-set / rule-on / rule-off` 改；每小时 `ai-cards periodic` 按用户本地日期发，同一周期只发一次。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT name AS \"规则\", CASE WHEN enabled THEN '开' ELSE '关' END AS \"状态\", period AS \"周期\", day AS \"日\", kind AS \"卡\", amount_cny AS \"金额 ¥\", count AS \"张数\", expires_days AS \"有效天数\", active_within_days AS \"近 N 天用过\", reason AS \"原因\", updated_by AS \"改动人\", to_char(updated_at, 'YYYY-MM-DD HH24:MI') AS \"改动时间\" FROM ai_quota_card_rules ORDER BY name"
    }
   ],

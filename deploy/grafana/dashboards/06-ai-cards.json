  {
   "type": "table",
   "transformations": [],
   "title": "每人没用的卡",
   "description": "ai_quota_cards：未用、没过期的卡。扩充卡的金额只有管理员看得到（用户只看到百分比）。`body-engine ai-cards list / ledger` 看明细，`ai-cards revoke` 收回。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT u.id AS \"id\", u.display_name AS \"用户\", count(c.id) FILTER (WHERE c.kind = 'reset') AS \"重置卡\", count(c.id) FILTER (WHERE c.kind = 'extend') AS \"扩充卡\", coalesce(sum(c.amount_cny), 0) AS \"扩充合计 ¥\", min(c.expires_at)::date::text AS \"最早到期\", (SELECT count(*) FROM ai_quota_cards x WHERE x.user_id = u.id AND x.status = 'used') AS \"累计用过\" FROM users u LEFT JOIN ai_quota_cards c ON c.user_id = u.id AND c.status = 'unused' AND (c.expires_at IS NULL OR c.expires_at > now()) GROUP BY u.id ORDER BY u.id"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "body-engine"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {

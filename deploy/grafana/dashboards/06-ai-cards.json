  {
   "type": "table",
   "transformations": [],
   "title": "额度流水",
   "description": "ai_quota_ledger：每次发放 / 使用 / 过期 / 收回一行（只追加）。用重置卡时「用前已用」就是清掉的金额。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT to_char(l.at, 'YYYY-MM-DD HH24:MI') AS \"时间\", u.display_name AS \"用户\", CASE l.event WHEN 'grant' THEN '发放' WHEN 'use' THEN '使用' WHEN 'expire' THEN '过期' WHEN 'revoke' THEN '收回' END AS \"事件\", CASE l.kind WHEN 'reset' THEN '重置卡' ELSE '扩充卡' END AS \"卡\", l.card_id AS \"卡号\", l.amount_cny AS \"金额 ¥\", round(l.spent_before_cny, 3) AS \"用前已用 ¥\", round(l.allowance_before_cny, 2) AS \"用前额度 ¥\", l.actor AS \"谁\", l.note AS \"说明\" FROM ai_quota_ledger l JOIN users u ON u.id = l.user_id WHERE l.at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz ORDER BY l.at DESC LIMIT 500"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "body-engine"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []

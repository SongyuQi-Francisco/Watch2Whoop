     "root_selector": "( $r := $[weight != null].{\"d\": entry_date, \"ms\": $toMillis(entry_date & \"T00:00:00+10:00\"), \"w\": weight}; $r.( $m := ms; $win := $r[ms > $m - 6*86400000 and ms <= $m]; {\"time\": d & \"T00:00:00+10:00\", \"weight\": w, \"avg7\": $round($average($win.w), 2), \"n7\": $count($win)} ) )",

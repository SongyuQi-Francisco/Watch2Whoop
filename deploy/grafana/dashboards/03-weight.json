  {
   "type": "timeseries",
   "title": "每日步数",
   "description": "OW 导入器按 HealthKit 规则去重（手表 > 手机），比快捷指令直接相加的数少。今天还没过完。",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "body-engine"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "WITH s AS (SELECT date, value FROM daily_metrics WHERE user_id = $user AND metric = 'step_count' AND date BETWEEN ($__timeFrom()::timestamptz)::date - 6 AND ($__timeTo()::timestamptz)::date), b AS (SELECT date, value, avg(value) OVER (ORDER BY date RANGE BETWEEN '6 days'::interval PRECEDING AND CURRENT ROW) AS m FROM s) SELECT date::timestamptz AS time, value AS \"步数\", m AS \"7 天均值\" FROM b WHERE date >= ($__timeFrom()::timestamptz)::date ORDER BY 1"
    }
   ],
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "body-engine"
   },
   "fieldConfig": {

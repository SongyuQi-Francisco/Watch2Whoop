# Open Wearables config template (local deployment). The real config is secrets/open_wearables.env (not tracked by git),
# generated from this template by deploy/open-wearables/init-secrets.py: __GENERATE__ is replaced with a random value.
# This file is used both as the docker compose --env-file (variable substitution) and as the env_file of each container.
# Ports: containers use the default ports inside; host ports are in compose.override.yaml (bound to 127.0.0.1 only).

#--- APP ---#
ENVIRONMENT=production
API_PORT=8000
API_BASE_URL=http://localhost:8200
FRONTEND_URL=http://localhost:8201
CORS_ORIGINS=["http://localhost:8201","http://127.0.0.1:8201"]
# Anonymous usage statistics: the 0.9.0 backend has no such switch yet; set here so it takes effect once a later version adds it
TELEMETRY_ENABLED=false
SENTRY_ENABLED=false
SENTRY_DSN=
# Email (for developer invitations), not used locally
RESEND_API_KEY=disabled

#--- DB ---#
DB_HOST=db
DB_PORT=5432
DB_NAME=open-wearables
DB_USER=open-wearables
DB_PASSWORD=__GENERATE__

#--- REDIS ---#
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false

#--- AUTH ---#
SECRET_KEY=__GENERATE__
# Admin account of the developer portal (http://localhost:8201), created automatically on first start
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=__GENERATE__

#--- Object storage (SeaweedFS, S3-compatible), used for chunked upload of the Apple Health export.xml ---#
AWS_BUCKET_NAME=open-wearables
AWS_ACCESS_KEY_ID=__GENERATE__
AWS_SECRET_ACCESS_KEY=__GENERATE__
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://seaweedfs:8333
AWS_PUBLIC_ENDPOINT_URL=http://localhost:8203
APPLE_XML_UPLOAD_COMPLETION_MODE=client
SDK_PAYLOAD_S3_OFFLOAD=false

#--- SYNC ---#
SYNC_INTERVAL_SECONDS=3600
SLEEP_SCORE_INTERVAL_SECONDS=600
RESILIENCE_SCORE_INTERVAL_SECONDS=600
SYNC_RUN_TRACKING_ENABLED=true
PERSIST_LIVE_SYNC_RUNS=false
HISTORICAL_SYNC_ON_CONNECT=true
INGEST_WORKOUT_SAMPLES=false
STORE_FIT_FILES=false
DEFAULT_DATA_GRANULARITY=raw

#--- Outbound webhooks (Svix), not enabled for now ---#
OUTGOING_WEBHOOKS_ENABLED=false
SVIX_SERVER_URL=http://svix-server:8071

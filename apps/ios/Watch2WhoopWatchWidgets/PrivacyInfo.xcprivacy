<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest of the watch-face complications (a WidgetKit extension inside the watch app; every bundle that calls a
  required-reason API needs its own, or App Store Connect answers the upload with ITMS-91053). Required-reason APIs:
  - UserDefaults: 1C8F.1, the App Group suite the watch app writes (WatchShared/WatchStore.swift); CA92.1, the language
    override in I18n.swift (the extension's own defaults).
  It collects nothing (it only draws what the watch app stored). No tracking, no tracking domains.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>

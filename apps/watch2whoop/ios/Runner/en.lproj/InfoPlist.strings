/* iOS permission prompts, English (the development language). Chinese: zh-Hans.lproj/InfoPlist.strings; keep the two in step. */
"NSCameraUsageDescription" = "Used to scan the setup QR code, and to take a photo or video when you choose to send one to your AI on the Today page.";
"NSHealthShareUsageDescription" = "Watch2Whoop reads your Health data (heart rate, HRV and beat-to-beat intervals, ECG recordings, sleep, workouts and more) and syncs it only to the server you set up.";
"NSHealthUpdateUsageDescription" = "Release builds never write to Health; only debug builds write test data in the simulator.";
"NSMicrophoneUsageDescription" = "Used only while you hold the mic button to talk to your AI, or record a video for it, on the Today page; the sound is turned into text on this iPhone or on your server and is not kept.";
